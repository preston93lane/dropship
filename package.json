{
  "name": "dropship-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI-agent dropshipping operating system: research, plan, execute, adapt, improve.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test --test-reporter=spec \"supabase/functions/_shared/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "check:edge": "npx --yes deno@2.9.6 check --node-modules-dir=none supabase/functions/gateway/index.ts supabase/functions/guardian/index.ts",
    "economics": "node --experimental-strip-types --no-warnings scripts/economics.ts",
    "forecast": "node --experimental-strip-types --no-warnings scripts/forecast.ts",
    "agents:sync-claude-code": "node scripts/sync-claude-code-agents.mjs",
    "agents:plan": "npm run skills:clean && ant apply --dry-run -v agents environments vaults memory_stores deployments",
    "proposals:pull": "node scripts/proposals.mjs",
    "dev:gateway": "node --experimental-strip-types --no-warnings scripts/dev-gateway.ts",
    "playbook:seed": "node --experimental-strip-types --no-warnings scripts/seed-playbook.ts",
    "skills:clean": "node scripts/clean-skills.mjs",
    "agents:apply": "npm run skills:clean && ant apply agents environments vaults memory_stores deployments",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts",
    "loop": "node scripts/loop.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
