# ---------------------------------------------------------------------------
# Gateway / guardian secrets (set with: supabase secrets set --env-file .env)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in Edge Functions.
# ---------------------------------------------------------------------------
DRY_RUN=true                         # keep true until each integration is verified against a test store/account
GATEWAY_ADMIN_KEY=                   # long random string: your console password (openssl rand -hex 32)
GUARDIAN_CRON_SECRET=                # long random string, also stored in Supabase Vault for pg_cron
# Scoped agent keys: {"<key>": [scopes]}. Generate each key with openssl rand -hex 32.
# research: read,research,report | creative: read,creative,report | ops: read,research,creative,actions,report | improve: read,improve,report,research
GATEWAY_AGENT_KEYS_JSON=
CONSOLE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/gateway/console

# Shopify (custom app, Admin API)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
STOREFRONT_DOMAIN=                   # your custom domain, for product URLs in ads
SHOPIFY_ONLINE_STORE_PUBLICATION_ID= # gid://shopify/Publication/...
SHOPIFY_TIKTOK_PUBLICATION_ID=       # gid of the TikTok sales channel publication

# Meta Marketing API (system user token with ads_management)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=                  # digits only, without act_
META_PAGE_ID=
META_PIXEL_ID=
META_INSTAGRAM_USER_ID=
META_API_VERSION=v24.0

# TikTok Business API
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_PIXEL_ID=
TIKTOK_IDENTITY_ID=
TIKTOK_IDENTITY_TYPE=CUSTOMIZED_USER

# Supplier (CJ Dropshipping) for sample orders
CJ_ACCESS_TOKEN=
SAMPLE_SHIP_TO_JSON={"shippingCountryCode":"US","shippingProvince":"NY","shippingCity":"New York","shippingAddress":"YOUR ADDRESS","shippingZip":"10001","shippingCustomerName":"YOUR NAME","shippingPhone":"YOUR PHONE","logisticName":"CJPacket","fromCountryCode":"US"}

# Notifications (free): Telegram bot (@BotFather) and/or a Slack/Discord-compatible webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# Optional: let the guardian wake loops early (winners, fatigue). Deployment ids from claude-lock.json.
ANTHROPIC_API_KEY=
LOOP_DEPLOYMENTS_JSON={"create":"depl_...","adapt":"depl_..."}

# ---------------------------------------------------------------------------
# Local mode only (Claude Code on your machine)
# ---------------------------------------------------------------------------
# GATEWAY_URL=http://localhost:8787
# GATEWAY_KEY=dev-agent-key
# FAL_KEY=                           # fal.ai key; without it media scripts run in dry-run mode
